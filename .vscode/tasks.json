{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Build (Docker)",
      "type": "shell",
      "command": "pnpm build:docker",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Dev Server",
      "type": "shell",
      "command": "pnpm dev",
      "group": "none",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Gateway Dev",
      "type": "shell",
      "command": "pnpm gateway:dev",
      "group": "none",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "pnpm lint",
      "group": "none",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Format Check",
      "type": "shell",
      "command": "pnpm format:check",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Format Fix",
      "type": "shell",
      "command": "pnpm format:fix",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Test All",
      "type": "shell",
      "command": "pnpm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Test (Watch)",
      "type": "shell",
      "command": "pnpm vitest --watch",
      "group": "test",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "pnpm exec tsc --noEmit",
      "group": "none",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Dead Code Check",
      "type": "shell",
      "command": "pnpm deadcode:knip",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Duplicate Check",
      "type": "shell",
      "command": "pnpm dup:check",
      "group": "none",
      "problemMatcher": []
    }
  ]
}
